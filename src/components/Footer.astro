---
import Arrow from './Arrow.astro';
import InstagramLink from './InstagramLink.astro';
---
<footer class="site-footer">
  <div class="shell">
    <div class="footer-top">
      <p>Gençlerin yanında.<br />Hayatın içinde.</p>
      <a class="back-top" href="#top">Başa dön <Arrow direction="up" /></a>
    </div>
    <p class="footer-wordmark" aria-hidden="true">GENCHANE<span>.</span></p>
    <div class="footer-bottom">
      <p>GENCHANE, Başkayalar Kantin İşletmeciliği'nin tescilli markasıdır.</p>
      <div class="footer-links">
        <InstagramLink label="Instagram’da GENCHANE" />
        <a href="#story">Hikâyemizi keşfedin <Arrow direction="up" /></a>
      </div>
    </div>
  </div>
</footer>
