---
import '@fontsource-variable/bricolage-grotesque';
import heroFont from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import primaryLogo from '../assets/genchane-hero.png';
import corporateLogo from '../../baskayalar.jpeg';
const title = 'GENCHANE — Öğrenci Dostu Yiyecek ve İçecek';
const description = "GENCHANE, Başkayalar Kantin İşletmeciliği'nin tescilli yiyecek ve içecek markasıdır. Öğrenci odaklı hizmet anlayışımızı, hikâyemizi ve hedeflerimizi keşfedin.";
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const socialImage = new URL('/social/genchane-og.png', Astro.site).href;
const websiteUrl = new URL('/', Astro.site).href;
const websiteId = `${websiteUrl}#website`;
const organizationId = `${websiteUrl}#organization`;
const brandId = `${websiteUrl}#brand`;
const [brandLogoImage, corporateLogoImage] = await Promise.all([
  getImage({ src: primaryLogo, width: 914, format: 'webp', quality: 90 }),
  getImage({ src: corporateLogo, width: 640, format: 'webp', quality: 90 }),
]);
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name: 'GENCHANE',
      url: websiteUrl,
      inLanguage: 'tr-TR',
      publisher: { '@id': organizationId },
      about: { '@id': brandId },
    },
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'Başkayalar Kantin İşletmeciliği',
      url: websiteUrl,
      description: '2022 yılında faaliyete başlayan Başkayalar Kantin İşletmeciliği, GENCHANE markasının işletmecisidir.',
      brand: { '@id': brandId },
      logo: new URL(corporateLogoImage.src, websiteUrl).href,
    },
    {
      '@type': 'Brand',
      '@id': brandId,
      name: 'GENCHANE',
      url: websiteUrl,
      description: 'Başkayalar Kantin İşletmeciliği’nin tescilli markası.',
      logo: new URL(brandLogoImage.src, websiteUrl).href,
      sameAs: ['https://www.instagram.com/genchane22/'],
    },
  ],
};
// Escape HTML delimiters so serialized values cannot close the JSON-LD script.
const structuredDataJson = JSON.stringify(structuredData).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content="GENCHANE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="GENCHANE logosu ve Gençlerin yanında, hayatın içinde mesajı" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="GENCHANE logosu ve Gençlerin yanında, hayatın içinde mesajı" />
    <meta name="theme-color" content="#050402" />
    <link rel="preload" href={heroFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{title}</title>
    {Astro.url.pathname === '/' && <script is:inline type="application/ld+json" set:html={structuredDataJson} />}
  </head>
  <body id="top">
    <a class="skip-link" href="#main">İçeriğe geç</a>
    <slot />
  </body>
</html>
